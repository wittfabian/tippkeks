# Copy to .env.local (development) or .env.prod (deployment) and fill in.
# Every key is explained in docs/configuration.md — this file is just the list.
# Check your work with: pnpm check-config [file] [--online]
#
# Local values: pnpm exec supabase status -o env
# NEVER commit real values. Only NEXT_PUBLIC_* reach the browser.

# --- Required ---
# Build time (inlined into the client bundle).
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only — bypasses RLS. Never prefix this NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Public deployment (skip locally) ---
# Canonical public origin, e.g. https://example.org
SITE_URL=""
# Directory with your own imprint.html + privacy.html — see examples/legal/
LEGAL_DIR=""
# Contact address shown on the info page; also the Web Push contact.
OPERATOR_EMAIL=""
# Guards POST /api/cron/sync: openssl rand -hex 32
CRON_SECRET=""
# Build time AND runtime, same value in both: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# --- Optional ---
# Live result sync. Free token: https://www.football-data.org/client/register
FOOTBALL_DATA_API_TOKEN=""
FOOTBALL_DATA_COMPETITION="WC"
# Cache + rate limiting. Local: REDIS_URL. Production: REDIS_PASSWORD only.
REDIS_URL=""
REDIS_PASSWORD=""
# Web Push: pnpm tsx scripts/generate-vapid-keys.ts
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Defaults to mailto: + OPERATOR_EMAIL.
VAPID_SUBJECT=""
