# Copy to .env.local and fill in. Local values come from `pnpm supabase status`.
# NEVER commit real secrets. Only NEXT_PUBLIC_* values reach the browser.

# --- Supabase (client-safe) ---
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- Supabase (server-only — never prefix NEXT_PUBLIC_) ---
# Used by the sync job / admin overrides / managed members to bypass RLS and use
# the Auth admin API deliberately on the server. Needed only at RUNTIME (the build
# never uses it). Local: from `pnpm exec supabase status -o env`. Production: a
# Secret key (`sb_secret_…`) from Dashboard → Settings → API Keys → Secret keys
# (the legacy `service_role` key under "Legacy API keys" also works until end of
# 2026). Either value goes here unchanged.
SUPABASE_SERVICE_ROLE_KEY=""

# --- football-data.org (server-only) ---
# Free token from https://www.football-data.org/client/register
FOOTBALL_DATA_API_TOKEN=""
# FIFA World Cup competition code on football-data.org.
FOOTBALL_DATA_COMPETITION="WC"

# --- Public origin (server-only) ---
# Canonical public URL of the deployment, e.g. https://tippkeks.de. Used to build
# absolute auth redirect links (email confirmation): behind a reverse proxy the
# request URL reflects the internal bind (0.0.0.0:3000), not the public host.
# OPTIONAL locally (request URL is correct without a proxy); set it in production.
SITE_URL=""

# --- Site operator (server-only) ---
# Who runs this instance. Rendered on /imprint and /privacy to satisfy § 5 DDG and
# Art. 13 GDPR — so a public deployment legally NEEDS all five. Deliberately not
# NEXT_PUBLIC_*: these are read per request, so the published container image
# carries nobody's personal data and every self-hoster shows their own details.
# Leave empty locally; the legal pages then say the operator is not configured.
OPERATOR_NAME=""
OPERATOR_STREET=""
OPERATOR_CITY=""
OPERATOR_COUNTRY=""
OPERATOR_EMAIL=""

# --- Cron sync endpoint protection (server-only) ---
# A long random string; the OS/container timer must send it as a Bearer token
# to POST /api/cron/sync. Generate with: openssl rand -hex 32
CRON_SECRET=""

# --- Valkey/Redis (server-only) ---
# Backs the data cache (tournament schedule, app settings, leaderboards) and
# auth rate limiting. OPTIONAL: leave empty to run without — the cache no-ops
# and rate limits fail open. Local dev: `podman compose up -d` (docker-compose.yml).
REDIS_URL=""
# Production only (docker-compose.prod.yml): Valkey requires this password
# (--requirepass), passed to both containers as a runtime env var; the app
# assembles REDIS_URL from it at startup. Generate a URL-safe value with:
# openssl rand -hex 32
REDIS_PASSWORD=""

# --- Web Push / VAPID (notifications) ---
# Tip reminders (~1h before kickoff) + result pushes to installed PWAs. OPTIONAL:
# leave empty to run without push (the toggle hides itself, the dispatcher no-ops).
# Generate a key pair once with: pnpm tsx scripts/generate-vapid-keys.ts
# The public key reaches the browser; the private key is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact URL the push services require. Defaults to `mailto:` + OPERATOR_EMAIL;
# set it only to use a different address than the one in the Impressum.
VAPID_SUBJECT=""

# --- Next.js Server Actions encryption (server-only, BUILD-TIME + runtime) ---
# Encrypts the arguments bound to Server Actions. Framework-level (not validated
# by src/lib/env.server.ts). `next build` consumes it and EMBEDS it into the build
# output (and compiles it into any Edge bundle, where runtime can't override it),
# so it must be present at build; pass the SAME value at runtime. OPTIONAL locally
# (Next generates a per-build key that rotates each rebuild). In production keep it
# stable across releases — MANDATORY and identical across all replicas once you run
# more than one. Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""
